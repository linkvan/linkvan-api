<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
      <title>LinkvanApi</title>
      <meta name="viewport" content="width=device-width,initial-scale=1">
      <%= csrf_meta_tags %>
      <%= csp_meta_tag %>

      <%= javascript_importmap_tags %>
      <%= javascript_import_module_tag "application" %>
      <%= stylesheet_link_tag "trix", "data-turbo-track": "reload" %>
      <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@7.2.0/css/all.min.css" %>
      <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body>
    <!-- Header -->
    <header>
      <%= render Layout::HeaderComponent.new %>
    </header>

    <!-- Flash messages -->
    <section class="section" id="flash_messages">
      <%= render Layout::FlashComponent.new %>
    </section>

    <!-- Content -->
    <section class="section">
      <%= yield %>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <%= render Layout::FooterComponent.new %>
    </footer>
  </body>
</html>
